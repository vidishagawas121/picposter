{
  "name": "picposter",
  "version": "1.0.0",
  "description": "PicPoster Monorepo Root",
  "private": true,
  "scripts": {
    "dev": "node run-dev.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "start": "npm --prefix backend start",
    "start:prod": "npm --prefix backend run start:prod",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "pm2:logs": "pm2 logs picposter-admin-backend",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "dotenv": "^18.0.4"
  }
}
