# ==============================================
# PicPoster Backend - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# MongoDB Connection
# Use a strong, unique connection string for production
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YourApp

# JWT Secrets (MUST be unique, random, 64+ characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_SECRET
JWT_REFRESH_EXPIRY=30d

# CORS Allowed Origins (comma-separated)
# Use * for development, specific domains for production
CORS_ALLOWED_ORIGINS=*

# SMS Provider Configuration
# Options: MOCK (service off/console log), FAST2SMS (live SMS)
SMS_PROVIDER=MOCK
SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
SMS_SENDER_ID=PICPST

# Admin Mobile Numbers (comma-separated, E.164 format)
ADMIN_MOBILES=+919876543210

# Logging
LOG_LEVEL=info
