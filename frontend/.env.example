# ==============================================================================
# PicPoster Frontend Dashboard Environment Configuration Template
# Domain: https://picposter.fouriseindia.com
# In Vite, variables must start with VITE_ to be exposed to client-side code.
# ==============================================================================

# Dev Server Port
VITE_PORT=3000

# Backend API Endpoint Base URL
# When deployed behind the Nginx reverse proxy on https://picposter.fouriseindia.com:
VITE_API_BASE_URL=https://picposter.fouriseindia.com/api/v1
VITE_ADMIN_API_BASE_URL=https://picposter.fouriseindia.com/api/v1/admin
