# ==============================================================================
# PicPoster Frontend Dashboard Environment Configuration Template
# In Vite, environment variables must start with VITE_ to be exposed to client-side code.
# ==============================================================================

# Backend API Endpoint Base URL (without trailing slash)
# For production behind Nginx reverse proxy, you can use: /api/v1
# For a separate API domain, use: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_ADMIN_API_BASE_URL=https://api.yourdomain.com/api/v1/admin
