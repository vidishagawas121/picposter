# ==============================================================================
# PicPoster Backend Environment Configuration Template
# NOTE: Copy this file to .env and fill in real production values on the VPS.
# NEVER commit the real .env file or real secrets to version control.
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production
API_BASE_URL=https://api.yourdomain.com
TRUST_PROXY=1

# CORS Allowed Origins (comma-separated origins, or * for unrestricted)
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# Database Connection (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database_name>?retryWrites=true&w=majority

# DNS Servers for MongoDB SRV resolution (optional, default: 8.8.8.8,1.1.1.1)
DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Authentication Secrets (Generate 64+ char random strings for production)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRY=30d

# SMS Gateway Provider (MOCK for testing, FAST2SMS for production)
SMS_PROVIDER=MOCK
FAST2SMS_API_KEY=your_fast2sms_api_key_here
SMS_API_KEY=
SMS_SENDER_ID=PICPST
