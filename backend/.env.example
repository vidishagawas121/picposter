# ==============================================================================
# PicPoster Backend Environment Variables Template
# Domain: https://picposter.fouriseindia.com
# Copy this file to .env on your VPS and configure production secrets.
# NEVER commit the real .env file or production secrets to Git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
API_BASE_URL=https://picposter.fouriseindia.com
TRUST_PROXY=1

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/picposter_db?retryWrites=true&w=majority

# DNS Resolution for MongoDB SRV in cloud/VPS environments (Default: 8.8.8.8,1.1.1.1)
DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Authentication Secrets (Use 64+ char random strings for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long
JWT_REFRESH_EXPIRY=30d

# CORS Allowed Origins
CORS_ORIGIN=https://picposter.fouriseindia.com
CORS_ALLOWED_ORIGINS=https://picposter.fouriseindia.com,http://localhost:3000

# SMS Provider Configuration (MOCK for testing, FAST2SMS for live SMS)
SMS_PROVIDER=FAST2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_OTP_URL=https://www.fast2sms.com/dev/otp/send
FAST2SMS_OTP_ID=45f33d9f8a
FAST2SMS_ENTITY_ID=1201178894876676977
SMS_SENDER_ID=FOURIS

# Admin Mobile Numbers (comma-separated, E.164 format e.g. +91XXXXXXXXXX)
ADMIN_MOBILES=+919876543210

# Logging level
LOG_LEVEL=info
