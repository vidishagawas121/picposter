# ==============================================================================
# PicPoster Backend Environment Variables Template
# Copy this file to .env on your VPS and fill with real production secrets.
# NEVER commit the real .env file or production secrets to Git!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
API_BASE_URL=https://api.yourdomain.com
TRUST_PROXY=1

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/picposter_db?retryWrites=true&w=majority

# DNS Resolution for MongoDB SRV (Optional comma-separated IPs; default: 8.8.8.8,1.1.1.1)
DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Authentication Secrets (Generate 64+ char random strings for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters
JWT_REFRESH_EXPIRY=30d

# CORS Allowed Origins (Comma-separated domains, or * for development)
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# SMS Provider Configuration (MOCK for development, FAST2SMS for production)
SMS_PROVIDER=MOCK
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
SMS_SENDER_ID=PICPST

# Admin Mobile Numbers (comma-separated, E.164 format)
ADMIN_MOBILES=+919876543210
LOG_LEVEL=info
